; *************************************************************
; *** SkyStar Bootloader: 32KB @ 0x08000000 (OTA-IAP) ***
; *** App 区位于 0x08008000/480KB，由 App 工程的 sct 描述 ***
; *************************************************************

LR_IROM1 0x08000000 0x00008000  {    ; Bootloader 独占 32KB（扇区 0-1）
  ER_IROM1 0x08000000 0x00008000  {  ; 代码段与只读数据
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; Bootloader 独占运行期全部 128KB SRAM
   .ANY (+RW +ZI)
  }
}
